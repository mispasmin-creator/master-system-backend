// ─────────────────────────────────────────────────────────────────
// Payment module. One row per payment request; it moves through
// `stage`/`status` rather than being copied into per-stage tables
// (the old app's 5 Supabase tables were redundant copies of the
// same record — collapsed here into one row with nullable
// stage-specific fields, matching how a single payment actually
// behaves). Page-access keys prefixed "Payment_" in the existing
// Login.page_access column; firm-scoping reuses whatever field the
// rest of the schema already uses for that (verify in Prompt 1 —
// add PaymentUserFirm only if nothing generic already exists).
// ─────────────────────────────────────────────────────────────────

model PaymentRequest {
  id                  String    @id @default(uuid())
  paymentNumber       String    @unique @map("payment_number")
  status              String    @default("Submitted")  // Submitted | Channel Funded | Approved | Posted | Payment Completed | Rejected
  uniqueNumber        String?   @map("unique_number")
  fmsName             String    @map("fms_name")
  firmName            String    @map("firm_name")
  payTo               String    @map("pay_to")
  amount              Float
  department          String?
  priority            String?
  remarks             String?
  attachmentUrl       String?   @map("attachment_url")
  supportingDocuments String?   @map("supporting_documents")

  maker               String?
  checker             String?
  approver            String?

  plannedDate         DateTime? @map("planned_date")
  actualDate          DateTime? @map("actual_date")
  delayDays           Float?    @map("delay_days")
  requiredDate        DateTime? @map("required_date")

  checkerRemarks      String?   @map("checker_remarks")
  approverRemarks     String?   @map("approver_remarks")
  reason              String?
  approvalStatus      String?   @map("approval_status")

  // Channel funding stage
  typeOfFunding       String?   @map("type_of_funding")
  fundingChannel      String?   @map("funding_channel")
  fundingRemarks      String?   @map("funding_remarks")
  fundingActual       DateTime? @map("funding_actual")
  fundingDelay        Float?    @map("funding_delay")
  fundingStatus       String?   @map("funding_status")   // old "StatusColP"

  // Approval stage
  approvalActual      DateTime? @map("approval_actual")   // old "Actual 2"
  approvalStageStatus String?   @map("approval_stage_status") // old "Status2"
  approvalStageRemarks String?  @map("approval_stage_remarks") // old "Remarks 2"

  // Posting stage
  postingPlanned      DateTime? @map("posting_planned")   // old "Planned 3"
  postingActual       DateTime? @map("posting_actual")    // old "Actual3"
  postingDelay        Float?    @map("posting_delay")     // old "Time Delay3"
  postingRemarks      String?   @map("posting_remarks")

  // Final payment stage
  paymentMode         String?   @map("payment_mode")
  finalPlanned        DateTime? @map("final_planned")     // old "Planned 4"
  finalActual         DateTime? @map("final_actual")      // old "Actual 4"
  finalDelay          Float?    @map("final_delay")       // old "Time Delay 4"
  financeRemarks      String?   @map("finance_remarks")

  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")

  history             PaymentHistoryEntry[]

  @@map("payment_request")
}

model PaymentHistoryEntry {
  id            String         @id @default(uuid())
  paymentId     String         @map("payment_id")
  title         String                    // e.g. "Payment Request Created", "Channel Funded"
  userName      String?        @map("user_name")
  userRole      String?        @map("user_role")
  comment       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  payment       PaymentRequest @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_history_entry")
}

model PaymentVendor {
  id           String   @id @default(uuid())
  vendorName   String   @unique @map("vendor_name")
  vendorType   String?  @map("vendor_type")
  gstNumber    String?  @map("gst_number")
  panNumber    String?  @map("pan_number")
  mobileNumber String?  @map("mobile_number")
  email        String?
  address      String?
  status       String   @default("Active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("payment_vendor")
}

model PaymentFmsMaster {
  id             String   @id @default(uuid())
  fmsName        String   @map("fms_name")
  firmName       String?  @map("firm_name")
  typeOfFunding  String?  @map("type_of_funding")
  paymentMode    String?  @map("payment_mode")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("payment_fms_master")
}

// ─────────────────────────────────────────────────────────────────
// Services module. Three core entities: ServiceOffer, ServiceJob
// (the "Service" sheet — one row per service, moving through 5
// stage-column groups; Bills/Tally/Reports pages are filtered views
// over this one model, not separate tables), and ServiceUtility (a
// fully separate recurring-utility-payment workflow). Page-access
// keys prefixed "Services_"; tab-level restriction (the old app's
// user.tabs granularity, e.g. "tally:audit") is stored the same way
// — verify in Prompt 1 whether Login already has a generic tab-scope
// field before adding a new one.
// ─────────────────────────────────────────────────────────────────

model ServiceOffer {
  id            String       @id @default(uuid())
  offerNo       String       @unique @map("offer_no")
  firmName      String       @map("firm_name")
  vendor        String
  description   String?
  location      String?
  amount        Float        @default(0)
  isOffer       String?      @map("is_offer")       // "Yes" | "No"
  offerCopy     String?      @map("offer_copy")      // file URL
  amountPaid    Float        @default(0) @map("amount_paid")
  outstanding   Float        @default(0)
  status        String       @default("Pending")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime?    @updatedAt @map("updated_at")

  services      ServiceJob[]

  @@map("service_offer")
}

model ServiceJob {
  id              String        @id @default(uuid())
  serviceNo       String        @unique @map("service_no")
  offerId         String?       @map("offer_id")
  firmName        String        @map("firm_name")
  checker         String?
  amount          Float         @default(0)
  tdsAmount       Float         @default(0) @map("tds_amount")
  remark          String?
  vendor          String
  description     String?
  location        String?

  // Stage 1 — work
  planned1        DateTime?     @map("planned_1")
  actual1         DateTime?     @map("actual_1")
  delay1          Float?        @map("delay_1")

  // Bill
  paymentFormDone Boolean       @default(false) @map("payment_form_done")
  billNo          String?       @map("bill_no")
  billCopy        String?       @map("bill_copy")      // file URL

  // Stage 2 — bill received
  planned2        DateTime?     @map("planned_2")
  actual2         DateTime?     @map("actual_2")
  delay2          Float?        @map("delay_2")

  paymentProof    String?       @map("payment_proof")  // file URL

  // Stage 3 — payment
  planned3        DateTime?     @map("planned_3")
  actual3         DateTime?     @map("actual_3")
  delay3          Float?        @map("delay_3")
  status3         String?       @map("status_3")
  remarks3        String?       @map("remarks_3")

  // Stage 4 — audit/rectify (Tally page's "Audit Stage"/"Rectify Stage")
  planned4        DateTime?     @map("planned_4")
  actual4         DateTime?     @map("actual_4")
  delay4          Float?        @map("delay_4")
  status4         String?       @map("status_4")
  remarks4        String?       @map("remarks_4")

  // Stage 5 — tally entry / completed
  planned5        DateTime?     @map("planned_5")
  actual5         DateTime?     @map("actual_5")
  delay5          Float?        @map("delay_5")
  status5         String?       @map("status_5")
  remarks5        String?       @map("remarks_5")

  paymentForm     String?       @map("payment_form")   // form/link
  status          String        @default("Service Created")  // derived display status, recomputed on write — see Prompt 3

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")

  offer           ServiceOffer? @relation(fields: [offerId], references: [id])

  @@map("service_job")
}

model ServiceUtility {
  id                  String    @id @default(uuid())
  utilityNo           String    @unique @map("utility_no")
  firmName            String    @map("firm_name")
  personName          String?   @map("person_name")
  userName            String?   @map("user_name")
  department          String?
  groupHead           String?   @map("group_head")
  payTo               String?   @map("pay_to")
  amount              Float     @default(0)
  billImage           String?   @map("bill_image")     // file URL
  billDate            DateTime? @map("bill_date")
  dueDate             DateTime? @map("due_date")
  remarks             String?
  tdsAmount           Float     @default(0) @map("tds_amount")
  amountPaid          Float     @default(0) @map("amount_paid")
  outstanding         Float     @default(0)
  status              String    @default("Pending Approval")

  planned1            DateTime? @map("planned_1")
  actual1             DateTime? @map("actual_1")
  delay1              Float?    @map("delay_1")
  planned2            DateTime? @map("planned_2")
  actual2             DateTime? @map("actual_2")
  delay2              Float?    @map("delay_2")
  paymentFormLink     String?   @map("payment_form_link")

  fmsName             String?   @map("fms_name")
  details             String?
  approvalAttachment  String?   @map("approval_attachment")  // file URL

  paymentNo           String?   @map("payment_no")
  paymentMode         String?   @map("payment_mode")
  transactionRef      String?   @map("transaction_ref")
  paymentDate         DateTime? @map("payment_date")
  paymentAttachment   String?   @map("payment_attachment")   // file URL
  paymentRemarks      String?   @map("payment_remarks")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")

  @@map("service_utility")
}

model ServiceMasterDropdown {
  id          String   @id @default(uuid())
  department  String?
  groupHead   String?  @map("group_head")
  firmName    String?  @map("firm_name")
  fmsName     String?  @map("fms_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("service_master_dropdown")
}

// ─────────────────────────────────────────────────────────────────
// Repair-FMS module. One RepairTask row per machine repair job,
// moving through Indent -> Sent to Vendor -> Check Machine ->
// Store In -> Make Payment stage-column groups (Accounts and
// Dashboard are filtered views over this one model, not separate
// tables — same shape as the Services module's ServiceJob).
// Page-access keys prefixed "Repair_"; firm-scoping reuses whatever
// field/pattern Prompt 1 confirms other firm-scoped modules already
// use on Login.
// ─────────────────────────────────────────────────────────────────

model RepairTask {
  id                            String    @id @default(uuid())
  taskNo                        String    @unique @map("task_no")
  firmName                      String    @map("firm_name")
  serialNo                      String?   @map("serial_no")
  machineName                   String?   @map("machine_name")
  machinePartName               String?   @map("machine_part_name")
  givenBy                       String?   @map("given_by")
  doerName                      String?   @map("doer_name")
  problem                       String?
  enableReminder                Boolean?  @map("enable_reminder")
  requireAttachment             Boolean?  @map("require_attachment")
  taskStartDate                 DateTime? @map("task_start_date")
  taskEndDate                   DateTime? @map("task_end_date")
  priority                      String?
  department                    String?
  location                      String?
  imageUrl                      String?   @map("image_url")       // file URL

  // Sent to Vendor stage
  planned                       DateTime? @map("planned")
  actual                        DateTime? @map("actual")
  delay                         Float?    @map("delay")
  vendorName                    String?   @map("vendor_name")
  leadTimeToDeliverDays         Float?    @map("lead_time_to_deliver_days")
  transporterName               String?   @map("transporter_name")
  transportationCharges         Float?    @map("transportation_charges")
  weighmentSlip                 String?   @map("weighment_slip")   // file URL
  transportingImageWithMachine  String?   @map("transporting_image_with_machine") // file URL
  paymentType                   String?   @map("payment_type")
  howMuch                       Float?    @map("how_much")

  // Check Machine stage
  planned1                      DateTime? @map("planned_1")
  actual1                       DateTime? @map("actual_1")
  transportationAmount          Float?    @map("transportation_amount")

  // Store In stage
  returnTransporterName         String?   @map("return_transporter_name")   // old "tranporterName"
  billImage                     String?   @map("bill_image")     // file URL
  billNo                        String?   @map("bill_no")
  typeOfBill                    String?   @map("type_of_bill")
  totalBillAmount               Float?    @map("total_bill_amount")
  toBePaidAmount                Float?    @map("to_be_paid_amount")
  planned2                      DateTime? @map("planned_2")
  actual2                       DateTime? @map("actual_2")
  delay2                        Float?    @map("delay_2")
  receivedQuantity              Float?    @map("received_quantity")
  billMatch                     String?   @map("bill_match")
  productImage                  String?   @map("product_image")  // file URL

  // Accounts Stage (Audit Steps)
  planned3                      DateTime? @map("planned_3")
  actual3                       DateTime? @map("actual_3")
  delay3                        Float?    @map("delay_3")
  status1                       String?   @map("status_1")
  remarks1                      String?   @map("remarks_1")
  status2                       String?   @map("status_2")
  remarks2                      String?   @map("remarks_2")
  status3                       String?   @map("status_3")
  remarks3                      String?   @map("remarks_3")
  status4                       String?   @map("status_4")
  remarks4                      String?   @map("remarks_4")

  // Make Payment stage
  planned4                      DateTime? @map("planned_4")
  actual4                       DateTime? @map("actual_4")
  status                        String    @default("Pending")   // "Pending" | "Complete"

  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime? @updatedAt @map("updated_at")

  advancePayments               RepairAdvancePayment[]

  @@map("repair_task")
}

model RepairAdvancePayment {
  id              String     @id @default(uuid())
  taskId          String?    @map("task_id")
  taskNo          String?    @map("task_no")
  paymentNo       String?    @map("payment_no")
  firmName        String     @map("firm_name")
  serialNo        String?    @map("serial_no")
  machineName     String?    @map("machine_name")
  vendorName      String?    @map("vendor_name")
  billNo          String?    @map("bill_no")
  totalBillAmount Float?     @map("total_bill_amount")
  paymentType     String?    @map("payment_type")
  toBePaidAmount  Float?     @map("to_be_paid_amount")
  billMatch       String?    @map("bill_match")
  amount          Float      @default(0)
  paidTo          String?    @map("paid_to")
  paymentMode     String?    @map("payment_mode")
  remarks         String?
  paidDate        DateTime?  @map("paid_date")
  createdAt       DateTime   @default(now()) @map("created_at")

  task            RepairTask? @relation(fields: [taskId], references: [id])

  @@map("repair_advance_payment")
}

model RepairMasterDropdown {
  id              String   @id @default(uuid())
  department      String?
  firmName        String?  @map("firm_name")
  vendorName      String?  @map("vendor_name")
  transporterName String?  @map("transporter_name")
  machineName     String?  @map("machine_name")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("repair_master_dropdown")
}





