// ─────────────────────────────────────────────────────────────────
// Inventory module. Firms are literals 'Purab' | 'Pmmpl' | 'Rkl'
// ('Madhya' from the old app folds into 'Pmmpl' — normalize on write).
// No DB-level generated columns or triggers here on purpose — derived
// values (optimum stock, max stock, colour flag, current level) are
// computed in src/inventory/shared/inventoryFormulas.js, matching how
// the rest of this codebase keeps logic in controllers, not SQL.
// Page-access keys for this module are prefixed "Inventory_" in the
// existing Login.page_access column (e.g. Inventory_RawMaterial_Purab).
// ─────────────────────────────────────────────────────────────────

model InventoryRawMaterial {
  id                String              @id @default(uuid())
  firmName          String              @map("firm_name")
  itemName          String              @map("item_name")
  unit              String?             @default("")
  sNo               Int?                @map("s_no")
  opStock           Float               @default(0) @map("op_stock")
  opStockDate       DateTime?           @map("op_stock_date")
  actualLevel       Float               @default(0) @map("actual_level")
  productRate       Float               @default(0) @map("product_rate")
  annualConsumption Float               @default(0) @map("annual_consumption")
  safetyFactor      Float               @default(1) @map("safety_factor")
  leadTimeDays      Float               @default(0) @map("lead_time_days")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime?           @updatedAt @map("updated_at")
  movements         InventoryMovement[]

  @@unique([firmName, itemName])
  @@map("inventory_raw_material")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  rawMaterialId String?               @map("raw_material_id")
  firmName      String                @map("firm_name")
  itemName      String                @map("item_name")
  movementType  String                @map("movement_type")  // RECEIPT | CONSUMPTION | ADJUSTMENT | RETURN
  quantity      Float
  sourceModule  String                @map("source_module")  // "purchase" | "production" | "order" | "manual"
  sourceTable   String                @map("source_table")   // e.g. "PurchaseReceipt"
  sourceId      String                @map("source_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  rawMaterial   InventoryRawMaterial? @relation(fields: [rawMaterialId], references: [id])

  @@unique([sourceModule, sourceTable, sourceId, movementType])
  @@map("inventory_movement")
}

model InventoryFinishedGoods {
  id                       String    @id @default(uuid())
  firmName                 String    @map("firm_name")
  productName              String    @map("product_name")
  sNo                      Int?      @map("s_no")
  opStock                  Float     @default(0) @map("op_stock")
  opStockDate              DateTime? @map("op_stock_date")
  stockAdjustment          Float     @default(0) @map("stock_adjustment")
  salesOrderPending        Float     @default(0) @map("sales_order_pending")
  purchaseMaterialReceived Float     @default(0) @map("purchase_material_received")
  liftMaterial             Float     @default(0) @map("lift_material")
  inTransit                Float     @default(0) @map("in_transit")
  purchaseReturn           Float     @default(0) @map("purchase_return")
  production               Float     @default(0) @map("production")
  sales                    Float     @default(0) @map("sales")
  salesReturn              Float     @default(0) @map("sales_return")
  consumption              Float     @default(0) @map("consumption")
  currentLevel             Float     @default(0) @map("current_level")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime? @updatedAt @map("updated_at")

  @@unique([firmName, productName])
  @@map("inventory_finished_goods")
}

model InventoryTradingMaterial {
  id                       String    @id @default(uuid())
  firmName                 String    @map("firm_name")
  productName              String    @map("product_name")
  sNo                      Int?      @map("s_no")
  unit                     String?   @default("")
  opStock                  Float     @default(0) @map("op_stock")
  opStockDate              DateTime? @map("op_stock_date")
  stockAdjustment          Float     @default(0) @map("stock_adjustment")
  purchaseMaterialReceived Float     @default(0) @map("purchase_material_received")
  purchaseReturn           Float     @default(0) @map("purchase_return")
  sales                    Float     @default(0) @map("sales")
  salesReturn              Float     @default(0) @map("sales_return")
  currentLevel             Float     @default(0) @map("current_level")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime? @updatedAt @map("updated_at")

  @@unique([firmName, productName])
  @@map("inventory_trading_material")
}

model InventoryStockAdjustment {
  id        String   @id @default(uuid())
  date      DateTime
  firmName  String   @map("firm_name")
  category  String            // "RawMaterial" | "FinishedGoods" | "TradingMaterial"
  itemName  String   @map("item_name")
  qty       Float
  direction String            // "Factory +" | "Factory -" (kept identical to old status field)
  remark    String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("inventory_stock_adjustment")
}

model InventoryOpStockLog {
  id          String   @id @default(uuid())
  firmName    String   @map("firm_name")
  category    String            // "RawMaterial" | "FinishedGoods"
  itemName    String   @map("item_name")
  opStock     Float    @map("op_stock")
  opStockDate DateTime @map("op_stock_date")
  changedBy   String?  @map("changed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("inventory_op_stock_log")
}

model InventoryRawMaterialHistory {
  id           String   @id @default(uuid())
  snapshotDate DateTime @map("snapshot_date")
  firmName     String   @map("firm_name")
  itemName     String   @map("item_name")
  unit         String?
  actualLevel  Float?   @map("actual_level")
  capturedAt   DateTime @default(now()) @map("captured_at")

  @@unique([snapshotDate, firmName, itemName])
  @@map("inventory_raw_material_history")
}

model InventoryFinishedGoodsHistory {
  id           String   @id @default(uuid())
  snapshotDate DateTime @map("snapshot_date")
  firmName     String   @map("firm_name")
  productName  String   @map("product_name")
  currentLevel Float?   @map("current_level")
  capturedAt   DateTime @default(now()) @map("captured_at")

  @@unique([snapshotDate, firmName, productName])
  @@map("inventory_finished_goods_history")
}

model InventoryActivityLog {
  id        String   @id @default(uuid())
  userRole  String?  @map("user_role")
  userName  String?  @map("user_name")
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("inventory_activity_log")
}

// ─────────────────────────────────────────────────────────────────
// Checklist module models
// ─────────────────────────────────────────────────────────────────

model ChecklistDepartment {
